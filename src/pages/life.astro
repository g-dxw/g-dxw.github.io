---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPortfolio, formatDate, postsForTopic, projectsForTopic } from '../utils/portfolio';
import { topics } from '../data/topics';
const topic = topics.find((item) => item.id === 'outdoor-life')!;
const { posts, projects } = await getPortfolio();
const outdoorPosts = postsForTopic(topic, posts);
const outdoorProjects = projectsForTopic(topic, projects);
---
<Base title="户外与生活 · 旺仔" description="徒步、摩旅、轨迹与沿途的记录。看看旺仔在屏幕之外的兴趣，以及由这些兴趣长出的工具。">
  <div class="site-wrap">
    <header class="page-intro"><span class="eyebrow">OUTSIDE THE SCREEN</span><h1>去山里，<br />也去路上。</h1><p>喜欢徒步，也喜欢摩旅。走出去的时候，注意力回到脚下的路、沿途的风景，和下一个弯。</p></header>
    <div class="outside-intro"><p>考过中国登山协会初级户外指导员，带过队伍走山路。户外带来的不只有放松，也有新的好奇：怎样保留走过的轨迹，怎样整理照片，又怎样把这些记忆画成一张图。</p><a class="text-link" href="https://www.xiaohongshu.com/user/profile/667dfe4e000000000d024d55" target="_blank" rel="noopener noreferrer">小红书 · 旺仔爱运动 ↗</a></div>
    <section class="outside-section"><div class="section-heading"><div><span class="eyebrow">STORIES ALONG THE WAY</span><h2>路上的一些感受</h2></div></div><div class="writing-list">{outdoorPosts.map((post) => <a class="writing-row" href={`/blog/${post.id}/`}><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><div><h3>{post.data.title}</h3><p>{post.data.summary}</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></section>
    <section class="outside-section"><div class="section-heading"><div><span class="eyebrow">TOOLS FROM AN INTEREST</span><h2>兴趣，也能长成工具</h2></div><a class="text-link" href="/explore/outdoor-life/">沿着主题看看 →</a></div><div class="project-grid">{outdoorProjects.map((project) => <ProjectCard project={project} />)}</div></section>
  </div>
</Base>
<style>
  .outside-intro { display: grid; grid-template-columns: 1fr auto; gap: 45px; border-block: 1px solid var(--line); padding: 28px 0; align-items: center; }
  .outside-intro p { max-width: 750px; color: var(--muted); font-size: 15px; line-height: 1.95; }
  .outside-section { margin-top: 58px; }
  @media(max-width: 700px) { .outside-intro { grid-template-columns: 1fr; gap: 12px; } }
</style>
