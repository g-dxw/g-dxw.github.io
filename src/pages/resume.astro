<!doctype html>
<html lang="zh-CN" class="resume-demo-html">
  <head>
    <BaseHead
      title="代兴旺 · AI 应用开发工程师 / 前端架构师"
      description="代兴旺的在线简历：近 12 年软件开发经验，聚焦 AI 应用开发、前端架构、工程治理与交付。"
      noindex={true}
    />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
  </head>
  <body>
    <nav class="demo-nav" aria-label="简历章节导航">
      <a class="demo-nav__brand" href="#top">代兴旺</a>
      <div class="demo-nav__chapters">
        <a href="#abilities">能力</a>
        <a href="#experience">经历</a>
        <a href="#work">项目</a>
        <a href="#skills">技术</a>
      </div>
      <a class="demo-nav__download" href="/resume/dai-xingwang-resume.pdf" download>PDF 简历</a>
    </nav>

    <main class="story-world">
      <header class="hero" id="top">
        <div class="hero-moon" aria-hidden="true"></div>
        <svg class="hero-mountains" viewBox="0 0 1600 620" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 420C180 330 300 360 430 286C590 196 710 338 850 300C1040 248 1140 126 1320 230C1430 292 1510 270 1600 218V620H0Z" fill="currentColor" opacity=".38" />
          <path d="M0 510C230 414 370 472 535 394C690 322 830 462 1010 388C1190 316 1370 378 1600 318V620H0Z" fill="currentColor" opacity=".72" />
        </svg>
        <div class="hero-mist" aria-hidden="true"></div>

        <div class="story-shell hero-inner">
          <div class="hero-copy reveal">
            <p class="eyebrow">ONLINE RESUME · 2026</p>
            <h1><span>代</span><span>兴</span><span>旺</span></h1>
            <p class="hero-role">AI 应用开发工程师 <i></i> 前端架构师</p>
            <p class="hero-lead">
              近 12 年软件开发经验，在历史系统、业务变化与多方协作等复杂条件下识别关键约束，
              推动架构改造与产品交付；近阶段聚焦 AI 应用和可验证的协作研发流程。
            </p>
            <div class="hero-actions">
              <a class="paper-button" href="mailto:dxw525224259@gmail.com">邮件联系</a>
              <a class="text-link" href="/resume/dai-xingwang-resume.pdf" download>下载 PDF</a>
              <a class="text-link" href="https://github.com/g-dxw" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
          </div>

          <aside class="paper-dossier reveal" aria-label="求职状态">
            <span class="dossier-knot" aria-hidden="true"></span>
            <p class="dossier-mark">求职</p>
            <h2>离职，可尽快到岗</h2>
            <p>程序开发岗位优先重庆；旅行、徒步及摩托车相关方向可考虑异地。</p>
            <dl>
              <div><dt>方向</dt><dd>AI 应用 / 前端架构</dd></div>
              <div><dt>经验</dt><dd>近 12 年</dd></div>
              <div><dt>邮箱</dt><dd>dxw525224259@gmail.com</dd></div>
            </dl>
          </aside>
        </div>

        <a class="scroll-cue" href="#abilities"><span>沿弦阅历</span><i></i></a>
      </header>

      <svg class="story-string" aria-hidden="true" preserveAspectRatio="none">
        <defs>
          <linearGradient id="story-string-fade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#d2b06a" stop-opacity=".42" />
            <stop offset="80%" stop-color="#d2b06a" stop-opacity=".42" />
            <stop offset="84%" stop-color="#d2b06a" stop-opacity=".12" />
            <stop offset="88%" stop-color="#d2b06a" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path stroke="url(#story-string-fade)"></path>
      </svg>

      <section class="abilities story-shell" id="abilities" aria-labelledby="abilities-title">
        <header class="section-heading reveal">
          <p>CHAPTER I · 能力</p>
          <h2 id="abilities-title">不止掌握技术，<br />更能识别问题、拆解约束并推动落地。</h2>
        </header>
        <div class="paper-ribbons">
          {capabilities.map((item, index) => (
            <article class="paper-ribbon reveal" style={`--delay:${index * 90}ms`}>
              <span>{item.index}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <small>{item.evidence}</small>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="timeline-section" id="experience" aria-labelledby="timeline-title">
        <div class="story-shell">
          <header class="section-heading reveal">
            <p>CHAPTER II · 经历</p>
            <h2 id="timeline-title">一根弦，串起从业务理解<br />到工程交付的十二年。</h2>
          </header>

          <div class="timeline">
            {experiences.map((experience, index) => (
              <article class="timeline-entry reveal" style={`--delay:${index * 70}ms`}>
                <div class="timeline-date"><time>{experience.date}</time><span>{String(index + 1).padStart(2, '0')}</span></div>
                <span class="timeline-node" aria-hidden="true"><i></i></span>
                <div class="experience-paper">
                  <p class="experience-eyebrow">{experience.eyebrow}</p>
                  <h3>{experience.title}</h3>
                  <p>{experience.summary}</p>
                  <ul>{experience.stats.map((stat) => <li>{stat}</li>)}</ul>
                  <div class="experience-details">
                    {experience.bullets.map((bullet) => <p><span aria-hidden="true"></span>{bullet}</p>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ecosystem-section" id="work" aria-labelledby="ecosystem-title">
        <div class="story-shell ecosystem-layout">
          <header class="section-heading section-heading--light reveal">
            <p>CHAPTER III · 当前实践</p>
            <h2 id="ecosystem-title">Niffler 生态应用</h2>
            <p class="section-intro">以 AI 网关为中心，连接模型、创作工具和业务应用。本人负责需求调研、方案判断、AI 协作研发与真实运行验收。</p>
          </header>

          <div class="ecosystem-map reveal" aria-label="Niffler 生态应用关系图">
            <svg viewBox="0 0 720 600" aria-hidden="true">
              <defs>
                <marker id="map-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M0 0L8 4L0 8Z" class="map-arrowhead" />
                </marker>
              </defs>
              <path class="map-string map-string--application" d="M308 210 C262 174 214 154 150 142" marker-end="url(#map-arrow)" />
              <path class="map-string map-string--application" d="M360 190 C360 156 360 132 360 102" marker-end="url(#map-arrow)" />
              <path class="map-string map-string--application" d="M412 210 C458 174 506 154 570 142" marker-end="url(#map-arrow)" />
              <path class="map-string map-string--provider" d="M360 510 C360 460 360 430 360 408" marker-end="url(#map-arrow)" />
              <circle cx="360" cy="300" r="128" class="map-orbit" />
              <circle cx="360" cy="300" r="182" class="map-orbit map-orbit--outer" />
            </svg>
            <div class="ecosystem-core">
              <span>AI MODEL GATEWAY</span>
              <strong>Niffler</strong>
              <p>模型中转 · 路由 · 鉴权 · 协议适配</p>
            </div>
            {ecosystemNodes.map((node) => (
              <article class={`ecosystem-node ${node.className}`}>
                <span>{node.label}</span>
                <p>{node.detail}</p>
              </article>
            ))}
          </div>

          <div class="project-ledger">
            {projectDetails.map((project, index) => (
              <article class="project-entry reveal" style={`--delay:${index * 80}ms`}>
                <p>{project.label}</p>
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.text}</p>
                </div>
                <div class="project-entry__meta">
                  <span>{project.tech}</span>
                  <a href={project.href} target="_blank" rel="noopener noreferrer">{project.link} ↗</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="skills-section" id="skills" aria-labelledby="skills-title">
        <div class="story-shell">
          <header class="section-heading reveal">
            <p>CHAPTER IV · 技术与背景</p>
            <h2 id="skills-title">技术是工具，判断与交付<br />决定工具怎样被使用。</h2>
