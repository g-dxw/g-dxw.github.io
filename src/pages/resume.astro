          <div class="credentials">
            {credentials.map((credential, index) => (
              <article class="credential reveal" style={`--delay:${index * 80}ms`}>
                <span>{credential.type}</span>
                <div><h3>{credential.title}</h3><p>{credential.detail}</p></div>
              </article>
            ))}
          </div>
        </div>
