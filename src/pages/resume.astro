          <div class="finale-links">
            <a href="mailto:dxw525224259@gmail.com">dxw525224259@gmail.com</a>
            <a href="https://github.com/g-dxw" target="_blank" rel="noopener noreferrer">github.com/g-dxw</a>
            <a href="https://www.xiaohongshu.com/user/profile/667dfe4e000000000d024d55" target="_blank" rel="noopener noreferrer">小红书 · 旺仔爱运动</a>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const revealItems = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });

      revealItems.forEach((item) => observer.observe(item));

      const storyWorld = document.querySelector('.story-world');
      const hero = document.querySelector('.hero');
      const ecosystem = document.querySelector('.ecosystem-section');
      const ecosystemMap = document.querySelector('.ecosystem-map');
      const firstProject = document.querySelector('.project-entry');
      const finale = document.querySelector('.finale');
      const storyString = document.querySelector('.story-string');
      const storyPath = storyString?.querySelector('path');
      const storyFadeStops = storyString?.querySelectorAll('#story-string-fade stop');

      const drawStoryString = () => {
        if (!storyWorld || !hero || !ecosystem || !storyString || !storyPath) return;

        const width = window.innerWidth;
        const heroHeight = hero.offsetHeight;
        const height = Math.max(1, storyWorld.scrollHeight - heroHeight);
        const shell = document.querySelector('.story-shell');
        const shellLeft = shell?.getBoundingClientRect().left ?? 0;
        const baseX = width <= 620 ? 18 : width <= 900 ? 32 : shellLeft + 201;
        const sectionTop = ecosystem.offsetTop - heroHeight;
        const sectionBottom = sectionTop + ecosystem.offsetHeight;

        storyString.style.top = `${heroHeight}px`;
        storyString.style.height = `${height}px`;
        storyString.setAttribute('viewBox', `0 0 ${width} ${height}`);

        if (finale && storyFadeStops?.length === 4) {
          const finaleTop = finale.offsetTop - heroHeight;
          const fadeStart = Math.max(0, (finaleTop - 180) / height * 100);
          const fadeEnd = Math.min(100, (finaleTop + finale.offsetHeight * .52) / height * 100);
          storyFadeStops[1].setAttribute('offset', `${fadeStart}%`);
          storyFadeStops[2].setAttribute('offset', `${fadeStart + (fadeEnd - fadeStart) * .56}%`);
          storyFadeStops[3].setAttribute('offset', `${fadeEnd}%`);
        }

        if (width > 900 && ecosystemMap) {
          const worldRect = storyWorld.getBoundingClientRect();
          const mapRect = ecosystemMap.getBoundingClientRect();
          const headingRect = ecosystem.querySelector('.section-heading--light')?.getBoundingClientRect();
          const projectLabelRect = firstProject?.children[0]?.getBoundingClientRect();
          const projectContentRect = firstProject?.children[1]?.getBoundingClientRect();
          const mapTop = mapRect.top - worldRect.top - heroHeight;
          const targetX = headingRect
            ? (headingRect.right + mapRect.left) / 2 - worldRect.left
            : Math.max(baseX + 120, mapRect.left - worldRect.left - 34);
          const projectX = projectLabelRect && projectContentRect
            ? (projectLabelRect.right + projectContentRect.left) / 2 - worldRect.left
            : baseX;
          const bendStart = Math.max(80, mapTop - 72);
          const bendEnd = Math.min(sectionBottom - 70, mapTop + mapRect.height + 72);
          const corner = 34;

          storyPath.setAttribute('d', [
            `M ${baseX} 0`,
            `L ${baseX} ${bendStart}`,
            `C ${baseX} ${bendStart + 22}, ${baseX + 10} ${bendStart + corner}, ${baseX + corner} ${bendStart + corner}`,
            `L ${targetX - corner} ${bendStart + corner}`,
            `C ${targetX - 10} ${bendStart + corner}, ${targetX} ${bendStart + 46}, ${targetX} ${bendStart + 68}`,
            `L ${targetX} ${bendEnd - 68}`,
            `C ${targetX} ${bendEnd - 46}, ${targetX - 10} ${bendEnd - corner}, ${targetX - corner} ${bendEnd - corner}`,
            `L ${projectX + corner} ${bendEnd - corner}`,
            `C ${projectX + 10} ${bendEnd - corner}, ${projectX} ${bendEnd - 22}, ${projectX} ${bendEnd}`,
            `L ${projectX} ${height}`,
          ].join(' '));
          return;
        }

        const bend = width <= 620 ? 20 : 34;
        const bendStart = Math.max(80, sectionTop + 48);
        const bendEnd = Math.min(sectionBottom - 80, bendStart + (width <= 620 ? 300 : 380));
        const curve = width <= 620 ? 38 : 56;
        storyPath.setAttribute('d', [
          `M ${baseX} 0`,
          `L ${baseX} ${bendStart}`,
          `C ${baseX} ${bendStart + curve * .45}, ${baseX + bend} ${bendStart + curve * .55}, ${baseX + bend} ${bendStart + curve}`,
          `L ${baseX + bend} ${bendEnd - curve}`,
          `C ${baseX + bend} ${bendEnd - curve * .55}, ${baseX} ${bendEnd - curve * .45}, ${baseX} ${bendEnd}`,
          `L ${baseX} ${height}`,
        ].join(' '));
      };

      drawStoryString();
      requestAnimationFrame(drawStoryString);
      window.addEventListener('resize', drawStoryString, { passive: true });
      new ResizeObserver(drawStoryString).observe(storyWorld);
    </script>
  </body>
</html>

