---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

const capabilities = [
  {
    index: '壹',
    title: '复杂任务推进',
    text: '能够从模糊需求中识别核心问题，完成技术调研、方案验证、任务拆解、资源评估、兼容迁移和分阶段上线，推动涉及多个系统与角色的复杂改造落地。',
    evidence: '统一鉴权与权限重构 · 历史数据平稳迁移 · 多城市项目交付 · Angular 渐进迁移 React',
  },
  {
    index: '贰',
    title: '架构与工程治理',
    text: '具备前端架构及全栈交付经验，能够治理复杂画布、历史代码和性能问题，完成领域拆分、模块化、类型规范、可观测性与 CI/CD 建设。',
    evidence: '前端工程体系与构建效率治理 · 复杂业务流程画布领域化重构 · 线上可观测性 · 跨项目基础架构与 DevOps 体系',
  },
  {
    index: '叁',
    title: 'AI 协作研发',
    text: '将 AI 编程工具用于需求分析、代码库理解、跨仓库开发、测试和交付检查；本人负责目标边界、方案判断和结果验收，而不是把代码生成状态当作完成。',
    evidence: '需求确认 · 方案调研 · 任务拆解 · AI 协作实现 · 测试与运行验证 · Git 交付',
  },
  {
    index: '肆',
    title: 'AI 应用工程',
    text: '理解 AI 与确定性业务流程的协作方式，能够根据稳定性、调用成本和可控性，在固定工作流、意图判断、知识处理与工具调用之间划分边界。',
    evidence: '模型服务接入 · Provider 鉴权 · 模型路由 · 任务生命周期 · 多模态生成链路 · AI 前端工作台',
  },
];

const experiences = [
  {
    date: '2026.01 — 至今',
    eyebrow: '独立开发者 · 重庆',
    title: 'AI 应用学习、开源协作与独立产品实践',
    summary: '围绕 Niffler 生态应用和安养台，持续实践从需求调研、架构判断到 AI 协作开发、测试与交付的完整流程。',
    stats: ['Niffler 生态应用', 'AI 协作研发', '本地优先产品'],
    bullets: [
      '参与自托管 AI API 网关 Niffler 的二次开发，负责配套应用的需求调研、方案设计、AI 协作研发、测试验收与交付。',
      '完成 Vue 3 生图工作台、LingWeave 无限画布及 DramaClaw AI 短剧平台的配套开发，处理模型接入、任务状态、配置隔离和会话鉴权。',
      '独立规划本地优先的养老机构桌面管理系统“安养台”，开展复杂业务建模、数据隔离、桌面架构和高保真交互原型实践。',
    ],
  },
  {
    date: '2022.07 — 2025.12',
    eyebrow: '马上消费金融 · 前端开发工程师',
    title: '智能外呼平台架构升级与 AI 业务融合',
    summary: '负责核心前端、流程编排与复杂画布治理，推动工程升级、统一鉴权迁移以及 AI 节点与确定性工作流协同。',
    stats: ['构建 6 → 2 分钟', '部署 10 → 4 分钟', '约 20 人团队'],
    bullets: [
      '主导 Webpack → Vite、Node Sass → Dart Sass、Vue 2.6 → Vue 2.7 + TypeScript 升级，缩短日常构建和部署等待。',
      '重构 AntV X6 外呼流程画布，通过领域拆分、类型补齐、异步渲染和按需加载降低大数据量场景下的卡顿与页面卡死。',
      '负责统一鉴权迁移的技术调研、可行性验证、权限体系重构、历史数据迁移、兼容兜底及分阶段上线。',
      '参与 AI 能力落地，负责前端实现、流程编排、Prompt 设计和接口对接；产品及业务团队负责效果验证，相关方案逐步支持约 80% 的话术回复由 AI 生成，人工客服参与率降低约 40%（团队业务结果）。',
    ],
  },
  {
    date: '2018.05 — 2022.06',
    eyebrow: '平安智慧城市 · 前端开发工程师 / 产品经理',
    title: '智慧国资平台与融资服务平台',
    summary: '支撑南宁、重庆、贵阳等城市国资监管项目，建设前端基础体系，并推动 Angular 1.x 向 React 渐进迁移。',
    stats: ['约 1000 家监管对象', '构建 20 → 6 分钟', '3 个城市'],
    bullets: [
      '完成技术选型、项目脚手架、权限、路由、数据展示编辑模块及 DevOps 流水线建设，以统一代码库支撑多城市交付。',
      '负责国资数据上报、异常预警、数据看板和绩效指标考核等核心模块。',
      '承担产品经理职责，与国资委工作人员梳理需求，将复杂计算规则设计为支持公式与数据动态调整的可配置模块。',
      '主动提出并推动融资服务平台由 Angular 1.x 迁移至 React 16，制定渐进迁移、旧页面兼容和新需求承接方案。',
    ],
  },
  {
    date: '2016.04 — 2018.05',
    eyebrow: '猪八戒网 · Web 前端开发工程师',
    title: '天蓬企采与全站公共服务',
    summary: '独立完成从模板渲染、Node 业务处理到监控、限流和 DevOps 上线的完整交付，并维护全站公共头尾服务。',
    stats: ['覆盖全站 70%+', '部署节省约 60%', '前端到 Node 交付'],
    bullets: [
      '在缺少 Node.js、后端和 DevOps 经验的情况下，完成天蓬企采从前端模板渲染到 Node 业务处理及上线流水线的完整交付。',
      '处理多条件检索、排序、不同查询请求兼容和动态广告位插入等复杂搜索逻辑。',
      '独立维护覆盖全站 70%+ 产品的公共头尾服务，并通过 Jenkins 持续集成改造缩短部署时间。',
    ],
  },
  {
    date: '2014.09 — 2016.04',
    eyebrow: '重庆科智科技 · 项目经理',
    title: '课程平台建设与项目交付',
    summary: '带领 12 人开发团队完成课程平台建设、维护、进度管理和交付，并对接学校与教师资源。',
    stats: ['12 人团队', '课程平台', '招投标与交付'],
    bullets: [
      '负责项目排期、开发协作、质量跟踪和上线交付，推动线下课程内容向线上平台转化。',
      '参与学校需求沟通、教师资源对接和招投标文件编制。',
    ],
  },
];

const ecosystemNodes = [
  { className: 'ecosystem-node--provider', label: '模型服务 / Provider', detail: 'Claude · OpenAI · Gemini · 图像模型' },
  { className: 'ecosystem-node--app-left', label: 'LingWeave', detail: 'AI 无限画布 · 素材引用 · Agent 创作' },
  { className: 'ecosystem-node--app-center', label: '生图工作台', detail: '图像生成 · 任务状态 · 结果管理' },
  { className: 'ecosystem-node--app-right', label: 'DramaClaw', detail: 'AI 短剧工作平台 · 剧本 · 分镜 · 生产流程' },
];

const projectDetails = [
  {
    label: '01 · 开源协作',
    title: 'Niffler 与生图工作台',
    text: '参与 AI API 网关及其配套应用开发，处理图像生成链路、Provider 鉴权、模型配置、任务状态、前端缓存和交付验证。',
    tech: 'Vue 3 · TypeScript · Rust · OpenAI Images',
    href: 'https://github.com/g-dxw/Niffler',
    link: '查看 Niffler',
  },
  {
    label: '02 · 开源二次开发',
    title: 'LingWeave / InfiniteCanvas',
    text: '面向个人创作者的 AI 无限画布，处理思考节点、Agent 重复生成、素材引用关系、提示词结构化和确定性输出。',
    tech: 'React · TypeScript · Infinite Canvas · Agent',
    href: 'https://github.com/g-dxw/lingweave',
    link: '查看 LingWeave',
  },
  {
    label: '03 · 个人产品原型',
    title: '安养台',
    text: '面向小型养老服务机构的本地优先桌面管理系统，用于验证养老业务模型、机构数据隔离和离线桌面架构。',
    tech: 'Tauri 2 · React · TypeScript · Rust · SQLite',
    href: 'https://g-dxw.github.io/caredock/',
    link: '查看原型',
  },
];

const skillGroups = [
  {
    title: '核心技术与前端架构',
    skills: [
      'JavaScript / TypeScript、React、Vue',
      '前端架构设计、复杂交互与状态管理',
      'Vite、Webpack、AntV X6、ECharts',
      '性能优化、工程化治理与响应式兼容',
    ],
  },
  {
    title: 'AI 应用与协作研发',
    skills: [
      'Prompt 设计、流程编排与输入来源管理',
      'LLM API、模型路由与任务状态项目实践',
      'AI 工作流与确定性业务流程协同',
      'Codex、Claude Code 协作开发及结果验收',
      '通过测试、构建、界面、日志和接口结果验证实现',
    ],
  },
  {
    title: '项目开发实践',
    skills: [
      'Node.js 业务开发与历史项目交付',
      'Python / FastAPI 项目开发实践',
      'MySQL / SQLite、Rust / Tauri 项目实践',
      'API 集成、数据建模与本地优先应用设计',
    ],
  },
  {
    title: '工程交付与基础工具',
    skills: [
      '技术方案评估与架构升级',
      '领域拆分、历史系统迁移与兼容方案',
      'CI/CD、Jenkins、Docker 基础使用',
      '自动化测试、浏览器验收、日志与可观测性',
      'Git 协作、版本管理与回滚控制',
    ],
  },
];

const credentials = [
  { type: '教育', title: '琼州学院 · 本科', detail: '数字媒体技术 · 2010.09—2014.07' },
  { type: '认证', title: 'PMP 项目管理认证', detail: '中国登山协会初级户外指导员 · 长期照护师' },
  { type: '荣誉', title: '海南多媒体软件大赛一等奖', detail: '两江新区第一届黑客马拉松最佳创意奖' },
];
