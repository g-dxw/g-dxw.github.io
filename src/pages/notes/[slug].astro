---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { topics } from '../../data/topics';
import { formatDate } from '../../utils/portfolio';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}
interface Props { note: CollectionEntry<'notes'> }
const { note } = Astro.props;
const { Content } = await render(note);
const relatedTopics = topics.filter((topic) => note.data.topics.includes(topic.id));
---

<Base title={`${note.data.title} · 随记 · 旺仔`} description={note.data.summary} type="article" publishedTime={note.data.date} tags={note.data.tags}>
  <article class="site-wrap note-detail" data-pagefind-body>
    <a class="text-link" href="/notes/" data-pagefind-ignore><span aria-hidden="true">←</span> 全部随记</a>
    <header class="note-header"><p class="eyebrow">FIELD NOTE <span aria-hidden="true">/</span> <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time></p><h1 data-pagefind-meta="title">{note.data.title}</h1><p class="note-summary">{note.data.summary}</p></header>
    <div class="prose note-body"><Content /></div>
    <footer class="note-end" data-pagefind-ignore>
      {relatedTopics.length > 0 && <div><p class="eyebrow">继续探索这个主题</p><div class="note-related">{relatedTopics.map((topic) => <a class="text-link" href={`/explore/${topic.id}/`}>{topic.title} <span aria-hidden="true">↗</span></a>)}</div></div>}
      <a class="text-link" href="/blog/">浏览全部文章与随记 <span aria-hidden="true">→</span></a>
    </footer>
  </article>
</Base>

<style>
  .note-detail { max-width: 860px; padding-top: 45px; padding-bottom: 90px; }
  .note-detail > .text-link { font-size: 13px; }
  .note-header { padding: 65px 0 32px; border-bottom: 1px solid var(--line); margin-bottom: 35px; }
  .note-header .eyebrow { display: flex; flex-wrap: wrap; gap: 14px; }
  .note-header h1 { font-size: clamp(30px, 4vw, 46px); letter-spacing: -.035em; line-height: 1.4; font-weight: 600; margin: 22px 0; }
  .note-summary { color: var(--muted); font-size: 17px; line-height: 1.9; }
  .note-body { max-width: none; }
  .note-end { border-top: 1px solid var(--line); padding-top: 30px; margin-top: 50px; display: flex; flex-direction: column; gap: 32px; }
  .note-related { margin-top: 16px; display: flex; gap: 20px; flex-wrap: wrap; }
</style>
