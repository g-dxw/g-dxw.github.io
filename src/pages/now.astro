---
import Base from '../layouts/Base.astro';
const current = [
  { number: '01', status: '正在改版', title: '重新整理这个个人站', text: '让作品、文章、随记和主题相互连接。把做过的东西、过程中的判断和生活里的兴趣，一起放进来。', href: '/notes/2026-10-19-connect-work-and-writing/', link: '这次调整的起点' },
  { number: '02', status: '梳理中', title: '整理最近的三个项目', text: 'e宝工坊、闲鱼自动发货工具、山姆代购。重新梳理每个项目解决的问题、自己的工作，以及已经做到和仍在推进的部分。', href: '/projects/', link: '看看作品' },
  { number: '03', status: '进行中', title: '继续推进轨迹生图', text: '把路线与旅行记忆转化成图像，是最近希望继续完成的事情。当前仍在推进，具体能力和进展会记录在项目里。', href: '/projects/trail-image-generation-skill/', link: '了解这项探索' },
  { number: '04', status: '计划', title: '写清楚多平台发布的设计', text: '准备写一篇文章，讲e宝工坊中多平台发布的设计与实现原理，并整理成适合小红书阅读的内容。', href: '/projects/ebao-studio/', link: '先了解e宝工坊' },
];
---

<Base title="近况 · 旺仔" description="截至 2026 年 10 月 19 日，正在投入的事情：个人站改版、近期项目梳理、轨迹生图与多平台发布文章。">
  <div class="site-wrap now-page">
    <header class="page-intro"><p class="eyebrow">NOW, NOT FOREVER</p><h1>最近，把时间<br />放在这些事情上。</h1><p>一份阶段性的近况，记录当下的关注与计划。</p></header>
    <div class="now-date"><span class="date-dot" aria-hidden="true"></span><p>最近更新于 <time datetime="2026-10-19">2026 年 10 月 19 日</time></p><span class="muted">重庆</span></div>
    <div class="now-list">{current.map((item) => <section><span class="now-number" aria-hidden="true">{item.number}</span><div><span class="pill">{item.status}</span><h2>{item.title}</h2><p>{item.text}</p><a class="text-link" href={item.href}>{item.link} <span aria-hidden="true">↗</span></a></div></section>)}</div>
    <aside class="now-footer"><p class="muted">这里记录当下，完整经历与兴趣放在关于页。</p><a class="text-link" href="/about/">再认识我一点 <span aria-hidden="true">→</span></a></aside>
  </div>
</Base>

<style>
  .now-page { max-width: 960px; padding-bottom: 96px; }
  .now-date { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding-bottom: 26px; border-bottom: 1px solid var(--line); font-size: 13px; }
  .now-date > .muted { margin-left: auto; }
  .date-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .now-list section { display: grid; grid-template-columns: 70px 1fr; gap: 20px; padding: 38px 0; border-bottom: 1px solid var(--line); }
  .now-number { font-size: 32px; color: var(--accent); font-family: Georgia, serif; font-style: italic; line-height: 1; padding-top: 5px; }
  .now-list h2 { font-size: clamp(22px, 3vw, 28px); line-height: 1.5; font-weight: 600; margin: 18px 0 14px; letter-spacing: -.025em; }
  .now-list section p { color: var(--muted); font-size: 15px; line-height: 1.95; max-width: 660px; margin-bottom: 22px; }
  .now-footer { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 20px; font-size: 14px; margin-top: 37px; }
  @media (max-width: 600px) { .now-list section { grid-template-columns: 35px 1fr; gap: 14px; } .now-number { font-size: 26px; } .now-date > .muted { display: none; } }
</style>
