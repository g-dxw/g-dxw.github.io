---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPortfolio, projectCategories } from '../utils/portfolio';
import { topics } from '../data/topics';
const { projects } = await getPortfolio();
---
<Base title="作品 · 旺仔" description="从桌面工作台、日常自动化，到轨迹工具与生活中的小实验。看看旺仔在做的项目，以及背后的问题与选择。" image="/images/projects/ebao-home.jpg">
  <div class="site-wrap">
    <header class="page-intro"><span class="eyebrow">WORK / THINGS I'VE BEEN MAKING</span><h1>从一个问题开始，<br />做出一点改变。</h1><p>有些是想认真打磨的产品，有些只是解决一个小麻烦的工具。这里收录了 {projects.length} 个项目，也保留它们的来处、取舍和当前进度。</p></header>
    <section aria-label="筛选作品" class="project-filters" data-pagefind-ignore>
      <div class="filter-bar" aria-label="作品类型"><button class="filter-button" type="button" data-category="all" aria-pressed="true">全部作品 <span>{projects.length}</span></button>{Object.entries(projectCategories).map(([id, label]) => <button class="filter-button" type="button" data-category={id} aria-pressed="false">{label} <span>{projects.filter((project) => project.data.category === id).length}</span></button>)}</div>
      <label class="topic-select">按兴趣看看 <select id="project-topic"><option value="all">所有主题</option>{topics.map((topic) => <option value={topic.id}>{topic.title}</option>)}</select></label>
    </section>
    <p class="results-description" id="project-count" role="status" aria-live="polite">共 {projects.length} 个作品</p>
    <div class="project-grid" id="project-list">{projects.map((project) => <div class="project-item" data-project-category={project.data.category} data-project-topics={project.data.topics.join(' ')}><ProjectCard project={project} headingLevel="h2" /></div>)}</div>
    <p id="project-empty" class="empty-state" hidden>这个组合暂时没有作品。换一个类型或主题看看。</p>
    <aside class="work-footnote"><span class="eyebrow">A NOTE ON THESE PROJECTS</span><p>作品包含个人工具、开源二次开发与产品原型。每个案例都注明上游与当前范围，项目状态也会随着实践继续调整。</p><a class="text-link" href="https://github.com/g-dxw" target="_blank" rel="noopener noreferrer">也可以去 GitHub 看看 <span aria-hidden="true">↗</span></a></aside>
  </div>
</Base>
<script>
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));
  const topicSelect = document.querySelector<HTMLSelectElement>('#project-topic');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project-category]'));
  let category = 'all';
  function applyFilters(updateUrl = true) {
    const topic = topicSelect?.value || 'all';
    let count = 0;
    for (const item of items) {
      const visible = (category === 'all' || item.dataset.projectCategory === category) && (topic === 'all' || item.dataset.projectTopics?.split(' ').includes(topic));
      item.hidden = !visible;
      if (visible) count++;
    }
    for (const button of categoryButtons) button.setAttribute('aria-pressed', String(button.dataset.category === category));
    const label = document.getElementById('project-count');
    if (label) label.textContent = `共 ${count} 个作品`;
    const empty = document.getElementById('project-empty');
    if (empty) empty.hidden = count !== 0;
    if (updateUrl) {
      const url = new URL(window.location.href);
      category === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', category);
      topic === 'all' ? url.searchParams.delete('topic') : url.searchParams.set('topic', topic);
      history.replaceState(null, '', url);
    }
  }
  const params = new URLSearchParams(window.location.search);
  if (categoryButtons.some((button) => button.dataset.category === params.get('category'))) category = params.get('category')!;
  if (topicSelect && Array.from(topicSelect.options).some((option) => option.value === params.get('topic'))) topicSelect.value = params.get('topic')!;
  applyFilters(false);
  categoryButtons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.category!; applyFilters(); }));
  topicSelect?.addEventListener('change', () => applyFilters());
</script>
<style>
  .project-filters { display: flex; justify-content: space-between; align-items: center; gap: 24px; border-bottom: 1px solid var(--line); padding-bottom: 24px; }
  .filter-bar { margin: 0; }
  .filter-button span { font-family: var(--font-mono); font-size: 10px; margin-left: 8px; opacity: .7; }
  .topic-select { font-size: 12px; color: var(--muted); display: flex; gap: 10px; align-items: center; }
  select { min-height: 44px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 4px; background: var(--page); color: var(--ink); max-width: 200px; font-size: 13px; }
  .results-description { padding: 23px 0; font-size: 12px; color: var(--muted); }
  .project-item { display: flex; min-width: 0; }
  .project-item > :global(.project-card) { width: 100%; }
  .work-footnote { margin-top: 56px; padding-top: 25px; border-top: 1px solid var(--line); }
  .work-footnote p { max-width: 680px; font-size: 14px; color: var(--muted); line-height: 1.9; margin: 12px 0; }
  @media(max-width: 760px) { .project-filters { flex-direction: column; align-items: flex-start; gap: 16px; } .filter-bar { gap: 7px; } .filter-button { padding: 8px 12px; } .filter-button span { margin-left: 4px; } }
</style>
