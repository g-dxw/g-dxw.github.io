---
import Base from '../layouts/Base.astro';

const milestones = [
  { years: '2026 — 现在', title: '把自己的想法做出来', text: '围绕 AI 工具、内容创作和具体业务，持续做产品与自动化实践，也把过程写下来。' },
  { years: '2022 — 2025', title: '马上消费金融', text: '参与智能外呼平台，经历复杂流程画布、工程升级、统一鉴权迁移和 AI 能力接入。' },
  { years: '2018 — 2022', title: '平安智慧城市', text: '参与智慧国资与融资服务平台，把不同城市的业务需求、监管规则和交付过程连接起来。' },
  { years: '2016 — 2018', title: '猪八戒网', text: '做过企业采购平台与公共服务，逐步把工作从页面延伸到 Node.js、监控与上线交付。' },
  { years: '2014 — 2016', title: '重庆科智科技', text: '参与课程平台建设、团队协作与项目交付，从学校和教师的实际需求出发推进工作。' },
];
---

<Base title="关于 · 旺仔" description="我是代兴旺，也叫旺仔。做产品、写代码、记录思考，也徒步、骑车，走到屏幕之外。">
  <div class="site-wrap about-page">
    <header class="page-intro"><p class="eyebrow">A LITTLE ABOUT ME</p><h1>我是代兴旺，<br />也可以叫我旺仔。</h1><p>做产品，写代码，记录思考。<br />也徒步、骑车，走到屏幕之外。</p></header>

    <div class="about-layout">
      <aside class="about-sidebar" aria-label="个人信息与入口">
        <div class="name-mark" aria-hidden="true">旺</div>
        <p class="sidebar-name">代兴旺 <span>/ 旺仔</span></p>
        <p class="sidebar-location"><span class="location-dot" aria-hidden="true"></span>重庆，中国</p>
        <nav class="about-links" aria-label="进一步了解"><a href="/projects/">看看我的作品 <span aria-hidden="true">↗</span></a><a href="/now/">最近在做什么 <span aria-hidden="true">↗</span></a><a href="/resume/">查看职业简历 <span aria-hidden="true">↗</span></a></nav>
        <a class="sidebar-mail" href="mailto:dxw525224259@gmail.com">dxw525224259@gmail.com</a>
      </aside>

      <div class="about-main">
        <section class="about-section about-opening" aria-labelledby="about-work"><p class="eyebrow">WHAT I CARE ABOUT</p><h2 id="about-work">用做过的事，<br />慢慢介绍自己。</h2><p>一个需要解决的问题，往往会把人带到不同的位置：有时要先理清需求，有时要设计流程，有时要写代码，也有时需要回到现场，看看它到底有没有用。</p><p>这些年做过前端、产品和项目交付。现在把更多时间放在自己的项目里，从真实使用场景出发，让想法一步步变成能使用的东西。</p><p>AI 让尝试新想法更容易，也让判断变得更重要。我关心怎样和它一起工作，以及怎样确认做出来的东西确实解决了问题。</p></section>

        <section class="about-section" aria-labelledby="about-method"><p class="eyebrow">HOW I WORK</p><h2 id="about-method">把问题看清，再往前推进。</h2><div class="approach-list"><div><span aria-hidden="true">01</span><div><h3>从具体场景出发</h3><p>谁在使用，哪里不方便，哪些规则必须被尊重。先理解问题，再决定工具与实现。</p></div></div><div><span aria-hidden="true">02</span><div><h3>让判断留下依据</h3><p>把关键选择、尝试和取舍记下来。作品展示结果，文章和随记补上中间的过程。</p></div></div><div><span aria-hidden="true">03</span><div><h3>回到使用中验证</h3><p>把东西做出来只是一步。继续观察实际操作、失败和反馈，逐步调整到更合适的位置。</p></div></div></div></section>

        <section class="about-section" aria-labelledby="about-journey"><div class="section-heading"><div><p class="eyebrow">THE PATH SO FAR</p><h2 id="about-journey">走过的一段路</h2></div></div><div class="journey-list">{milestones.map((milestone) => <div><span>{milestone.years}</span><div><h3>{milestone.title}</h3><p>{milestone.text}</p></div></div>)}</div><a class="text-link" href="/resume/">完整经历在简历里 <span aria-hidden="true">↗</span></a></section>

        <section class="about-section outside-section" aria-labelledby="about-outside"><p class="eyebrow">OUTSIDE THE SCREEN</p><h2 id="about-outside">还有山路，和下一个弯。</h2><p>徒步和摩旅是生活的另一部分。我考过中国登山协会初级户外指导员，带过队伍走山路，也喜欢骑着摩托车去看沿途的风景。</p><p>有些想法也从这里长出来：怎样整理走过的轨迹，怎样把路线、照片和旅行的记忆连在一起。生活里的兴趣，同样可以成为做东西的起点。</p><a class="text-link" href="/explore/outdoor-life/">走到屏幕之外 <span aria-hidden="true">→</span></a></section>

        <section class="about-section contact-section" aria-labelledby="about-contact"><p class="eyebrow">SAY HELLO</p><h2 id="about-contact">有想法，可以聊聊。</h2><p>关于项目、合作、一个值得解决的问题，或者一条不错的徒步路线。</p><div class="contact-links"><a href="mailto:dxw525224259@gmail.com">发封邮件 <span aria-hidden="true">↗</span></a><a href="https://github.com/g-dxw" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="https://www.xiaohongshu.com/user/profile/667dfe4e000000000d024d55" target="_blank" rel="noopener noreferrer">小红书 · 旺仔爱运动 <span aria-hidden="true">↗</span></a></div></section>
      </div>
    </div>
  </div>
</Base>

<style>
  .about-page { padding-bottom: 90px; }
  .about-layout { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 90px; padding-top: 10px; }
  .about-sidebar { align-self: start; position: sticky; top: 110px; }
  .name-mark { display: grid; place-items: center; width: 90px; height: 90px; border-radius: 50%; background: var(--ink); color: var(--page); font-family: Georgia, 'Songti SC', serif; font-size: 45px; margin-bottom: 26px; }
  .sidebar-name { font-size: 19px; font-weight: 600; }
  .sidebar-name span { font-size: 14px; color: var(--muted); font-weight: 400; margin-left: 7px; }
  .sidebar-location { display: flex; gap: 9px; align-items: center; font-size: 12px; color: var(--muted); margin-top: 14px; }
  .location-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .about-links { display: flex; flex-direction: column; padding-block: 24px; margin-block: 24px 20px; border-block: 1px solid var(--line); }
  .about-links a { display: flex; justify-content: space-between; align-items: center; min-height: 44px; font-size: 14px; text-decoration: none; }
  .about-links a:hover, .sidebar-mail:hover { color: var(--accent); }
  .sidebar-mail { font-size: 12px; color: var(--muted); text-underline-offset: 5px; overflow-wrap: anywhere; }
  .about-section { padding-bottom: 47px; margin-bottom: 47px; border-bottom: 1px solid var(--line); }
  .about-section h2 { font-size: clamp(24px, 2.5vw, 32px); line-height: 1.55; font-weight: 600; margin: 18px 0 22px; letter-spacing: -.025em; }
  .about-section > p:not(.eyebrow) { color: var(--muted); font-size: 16px; line-height: 1.95; margin-bottom: 18px; }
  .about-section > p:last-of-type { margin-bottom: 0; }
  .about-section > .text-link { display: inline-flex; margin-top: 23px; }
  .about-opening h2 { font-size: clamp(27px, 3vw, 38px); }
  .approach-list { display: flex; flex-direction: column; gap: 24px; }
  .approach-list > div { display: grid; grid-template-columns: 28px 1fr; gap: 16px; }
  .approach-list > div > span { padding-top: 3px; font-family: var(--font-mono); font-size: 12px; color: var(--accent); }
  .approach-list h3 { font-size: 17px; font-weight: 600; margin-bottom: 9px; }
  .approach-list p, .journey-list p { color: var(--muted); font-size: 14px; line-height: 1.9; }
  .journey-list { display: flex; flex-direction: column; gap: 28px; }
  .journey-list > div { display: grid; grid-template-columns: 120px 1fr; gap: 20px; }
  .journey-list > div > span { font-size: 12px; color: var(--muted); padding-top: 5px; }
  .journey-list h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
  .contact-section { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 14px 28px; margin-top: 25px; }
  .contact-links a { display: inline-flex; gap: 14px; align-items: center; min-height: 44px; font-size: 14px; text-decoration: none; border-bottom: 1px solid var(--line); }
  .contact-links a:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 850px) { .about-layout { grid-template-columns: 200px 1fr; gap: 40px; } .journey-list > div { grid-template-columns: 1fr; gap: 5px; } }
  @media (max-width: 620px) { .about-layout { grid-template-columns: 1fr; gap: 50px; } .about-sidebar { position: static; } .name-mark { width: 72px; height: 72px; font-size: 36px; float: right; margin-bottom: 0; } .about-links { padding-block: 12px; margin-block: 20px 15px; } .about-links a { max-width: 360px; } .about-section { padding-bottom: 34px; margin-bottom: 34px; } .journey-list > div { grid-template-columns: 110px 1fr; gap: 12px; } }
</style>
