---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: '作品' },
  { href: '/blog/', label: '文章' },
  { href: '/explore/', label: '探索' },
  { href: '/about/', label: '关于' },
];
---
<header class="site-header" data-pagefind-ignore>
  <nav class="site-wrap header-inner" aria-label="主导航">
    <a class="brand" href="/" aria-label="旺仔，返回首页"><svg class="brand-mark" viewBox="0 0 28 28" width="28" height="28" fill="none" aria-hidden="true"><path d="M14 2v24M2 14h24M5.5 5.5l17 17M5.5 22.5l17-17" stroke="currentColor" stroke-width="3" /></svg>旺仔<span class="brand-caption">的个人站</span></a>
    <div class="header-links">
      {links.map((link) => <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <span class="theme-control"><ThemeToggle /></span>
    </div>
  </nav>
</header>
