---
interface Props {
  mode?: 'compact' | 'page';
}
const { mode = 'compact' } = Astro.props;
const isPage = mode === 'page';
---

<div class:list={['site-search relative w-full max-w-md mx-auto', { 'mb-8': !isPage, 'search-page-mode': isPage }]} data-search-root data-mode={mode} data-pagefind-ignore>
  <form action="/search/" method="get" role="search" class="search-form">
    <div class="search-input-row">
      <label for="site-search-input" class="sr-only">搜索作品、文章与随记</label>
      <svg aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <input id="site-search-input" name="q" type="search" placeholder="搜索作品、文章与随记" autocomplete="off" aria-describedby="search-status" aria-controls="search-results" aria-expanded="false" />
      <button type="submit" class="search-submit" aria-label="提交搜索">搜索</button>
    </div>
    {isPage && <fieldset class="search-filters"><legend class="sr-only">搜索内容类型</legend>{[['all', '全部'], ['project', '作品'], ['article', '文章'], ['note', '随记']].map(([value, label]) => <label><input type="radio" name="type" value={value} checked={value === 'all'} /><span>{label}</span></label>)}</fieldset>}
  </form>
  <div class="search-panel" data-search-panel hidden>
    <p id="search-status" class="search-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <ol id="search-results" class="search-results" aria-label="搜索结果"></ol>
    {!isPage && <a class="search-more" data-search-more href="/search/">查看全部结果 <span aria-hidden="true">→</span></a>}
  </div>
  <noscript><p class="search-no-script">搜索需要启用 JavaScript，也可以浏览<a href="/projects/">作品</a>或<a href="/blog/">文章与随记</a>。</p></noscript>
</div>

<script>
  import { search, searchTypeLabels, type SearchFilter } from '../utils/search';

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('input[name="q"]')!;
    const form = root.querySelector<HTMLFormElement>('form')!;
    const panel = root.querySelector<HTMLElement>('[data-search-panel]')!;
    const status = root.querySelector<HTMLElement>('[role="status"]')!;
    const results = root.querySelector<HTMLOListElement>('ol')!;
    const more = root.querySelector<HTMLAnchorElement>('[data-search-more]');
    const filters = [...root.querySelectorAll<HTMLInputElement>('input[name="type"]')];
    const pageMode = root.dataset.mode === 'page';
    let timer: ReturnType<typeof setTimeout> | undefined;
    let revision = 0;
    let composing = false;
    const filter = (): SearchFilter => (filters.find((item) => item.checked)?.value || 'all') as SearchFilter;

    function show() {
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function close() {
      clearTimeout(timer);
      revision++;
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    }

    async function run() {
      clearTimeout(timer);
      const current = ++revision;
      const query = input.value.trim();
      results.replaceChildren();
      if (pageMode) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
        if (filter() === 'all') url.searchParams.delete('type'); else url.searchParams.set('type', filter());
        window.history.replaceState({}, '', url);
      }
      if (!query) {
        if (pageMode) {
          show();
          status.textContent = '输入关键词，搜索作品、文章与随记。';
        } else close();
        return;
      }
      show();
      status.textContent = '正在搜索…';
      if (more) more.href = `/search/?q=${encodeURIComponent(query)}`;
      try {
        const hits = await search(query, { type: filter(), limit: pageMode ? 100 : 6 });
        if (current !== revision) return;
        status.textContent = hits.length ? `找到 ${hits.length} 条${pageMode ? '结果' : '相关内容'}` : '没有找到匹配内容，试试其他关键词。';
        const fragment = document.createDocumentFragment();
        for (const hit of hits) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = hit.url;
          const type = document.createElement('span');
          type.className = 'search-hit-type';
          type.textContent = searchTypeLabels[hit.type];
          const title = document.createElement('strong');
          title.textContent = hit.title;
          const summary = document.createElement('p');
          summary.textContent = hit.summary;
          link.append(type, title, summary);
          item.append(link);
          fragment.append(item);
        }
        results.replaceChildren(fragment);
      } catch {
        if (current !== revision) return;
        status.textContent = '搜索暂时无法加载，请稍后重试。';
      }
    }

    function schedule() {
      clearTimeout(timer);
      revision++;
      if (composing) return;
      if (!input.value.trim()) { void run(); return; }
      results.replaceChildren();
      status.textContent = '正在搜索…';
      show();
      timer = setTimeout(() => { void run(); }, 250);
    }

    input.addEventListener('input', schedule);
    input.addEventListener('compositionstart', () => { composing = true; clearTimeout(timer); revision++; });
    input.addEventListener('compositionend', () => { composing = false; schedule(); });
    input.addEventListener('focus', () => { if (input.value.trim() && !composing) void run(); });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { input.focus(); close(); }
      if (event.key === 'ArrowDown' && event.target === input) {
        const first = results.querySelector<HTMLAnchorElement>('a');
        if (first) { event.preventDefault(); first.focus(); }
      }
    });
    document.addEventListener('click', (event) => { if (!pageMode && !root.contains(event.target as Node)) close(); });
    form.addEventListener('submit', (event) => {
      if (pageMode) { event.preventDefault(); void run(); }
    });
    filters.forEach((item) => item.addEventListener('change', () => { void run(); }));
    if (pageMode) {
      const params = new URLSearchParams(window.location.search);
      input.value = params.get('q') || '';
      const selected = params.get('type') || 'all';
      filters.forEach((item) => { item.checked = item.value === (['project', 'article', 'note'].includes(selected) ? selected : 'all'); });
      void run();
      window.addEventListener('popstate', () => {
        const state = new URLSearchParams(window.location.search);
        input.value = state.get('q') || '';
        const kind = state.get('type') || 'all';
        filters.forEach((item) => { item.checked = item.value === (['project', 'article', 'note'].includes(kind) ? kind : 'all'); });
        void run();
      });
    }
  }
</script>

<style>
  .site-search { position: relative; }
  .search-input-row { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 8px 0 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
  .search-input-row:focus-within { border-color: var(--accent); }
  .search-input-row svg { flex-shrink: 0; color: var(--muted); }
  input[type='search'] { min-width: 0; width: 100%; flex: 1; border: 0; padding: 12px 0; background: transparent; color: var(--ink); font: inherit; font-size: 14px; outline: none; }
  input[type='search']::placeholder { color: var(--muted); }
  .search-submit { flex-shrink: 0; min-height: 36px; border-radius: 5px; padding: 6px 10px; color: var(--accent); font-size: 13px; cursor: pointer; }
  .search-submit:hover { background: var(--soft); }
  .search-panel { position: absolute; inset: calc(100% + 8px) 0 auto; z-index: 40; max-height: 440px; overflow-y: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); box-shadow: 0 16px 32px #00000014; }
  .search-panel[hidden] { display: none; }
  .search-status { padding: 14px 16px; color: var(--muted); font-size: 13px; }
  .search-results { padding: 0; margin: 0; list-style: none; }
  .search-results :global(li) { border-top: 1px solid var(--line); }
  .search-results :global(a) { display: block; padding: 16px; text-decoration: none; transition: background .15s; }
  .search-results :global(a:hover), .search-results :global(a:focus-visible) { background: var(--soft); }
  .search-results :global(strong) { display: block; margin: 5px 0; font-size: 15px; line-height: 1.6; color: var(--ink); }
  .search-results :global(p) { font-size: 13px; line-height: 1.8; color: var(--muted); }
  .search-results :global(.search-hit-type) { font-size: 11px; color: var(--accent); }
  .search-results :global(.search-hit-url) { display: block; margin-top: 8px; font-size: 11px; color: var(--muted); overflow-wrap: anywhere; }
  .search-more { display: block; padding: 14px 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--accent); text-decoration: none; }
  .search-filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 20px 0; border: 0; }
  .search-filters label { cursor: pointer; }
  .search-filters input { appearance: none; position: absolute; width: 1px; height: 1px; opacity: 0; }
  .search-filters span { display: block; min-height: 40px; border-radius: 5px; padding: 9px 18px; font-size: 14px; color: var(--muted); }
  .search-filters input:checked + span { color: var(--page); background: var(--ink); }
  .search-filters input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 3px; }
  .search-page-mode { max-width: none; margin: 0; }
  .search-page-mode .search-panel { position: static; max-height: none; overflow: visible; border: 0; border-radius: 0; box-shadow: none; background: transparent; }
  .search-page-mode .search-status { padding: 12px 0 24px; }
  .search-page-mode .search-results :global(a) { padding: 24px 0; }
  .search-page-mode .search-results :global(strong) { font-size: clamp(19px, 3vw, 24px); }
  .search-page-mode .search-results :global(p) { max-width: 760px; font-size: 14px; }
  .search-no-script { font-size: 13px; color: var(--muted); line-height: 1.8; margin-top: 12px; }
  @media (prefers-reduced-motion: reduce) { .search-results :global(a) { transition: none; } }
</style>
